{
  "expo": {
    "name": "Upgrade",
    "slug": "upgrade",
    "scheme": "upgrade",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./src/assets/icon.png",
    "splash": {
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.upgrade.app",
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.upgrade.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RoutineWidget",
              "label": "Upgrade — Today's Routine",
              "minWidth": "220dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Shows today's progress ring and next routine items.",
              "previewImage": "./src/assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1a7626ea-9dce-4cc4-8b72-14e09e211af4"
      }
    }
  }
}
